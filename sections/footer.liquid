{% comment %}
  Flint & Veil — Footer Section
  File: sections/footer.liquid
{% endcomment %}

<footer class="site-footer" role="contentinfo">
  <div class="page-width">
    <div class="site-footer__grid">

      <div>
        <div class="site-footer__brand-name">Flint & Veil</div>
        <p class="site-footer__tagline">For what comes after.</p>
        <p class="site-footer__desc">Outdoor recovery supplements, topicals, and gear for people who earn their rest. Georgia compliant. Hemp-derived.</p>
        <div class="site-footer__social">
          <a href="https://instagram.com/flintandveil" class="site-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="https://tiktok.com/@flintandveil" class="site-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <p class="site-footer__col-title">Shop</p>
        <ul class="site-footer__links">
          <li><a href="/collections/all">All Products</a></li>
          <li><a href="/collections/recovery">Recovery</a></li>
          <li><a href="/collections/supplements">Supplements</a></li>
          <li><a href="/collections/gear">Gear & Accessories</a></li>
          <li><a href="/collections/bundles">Bundles</a></li>
        </ul>
      </div>

      <div>
        <p class="site-footer__col-title">Info</p>
        <ul class="site-footer__links">
          <li><a href="/pages/our-story">Our Story</a></li>
          <li><a href="/pages/ingredients">Our Ingredients</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/lab-results">Lab Results</a></li>
          <li><a href="/blogs/trail-notes">Trail Notes (Blog)</a></li>
        </ul>
      </div>

      <div>
        <p class="site-footer__col-title">Support</p>
        <ul class="site-footer__links">
          <li><a href="/pages/shipping">Shipping Info</a></li>
          <li><a href="/pages/returns">Returns & Exchanges</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/account">My Account</a></li>
        </ul>
      </div>

    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__legal">
        &copy; {{ 'now' | date: '%Y' }} Flint & Veil. All rights reserved.
        &nbsp;&middot;&nbsp;
        <a href="/policies/privacy-policy">Privacy</a>
        &nbsp;&middot;&nbsp;
        <a href="/policies/terms-of-service">Terms</a>
      </p>
      <span class="site-footer__compliance">Georgia compliant · Hemp-derived · All prices USD</span>
    </div>

  </div>
</footer>

