{% comment %}
  Flint & Veil — Announcement Bar
  File: sections/announcement-bar.liquid
{% endcomment %}

<div class="announcement-bar">
  <div class="announcement-bar__inner">
    {{ section.settings.message | default: 'Free shipping on orders over $50 · Georgia compliant · Hemp-derived' }}
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}"> {{ section.settings.link_label | default: 'Shop Now' }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Free shipping on orders over $50 · Georgia compliant · Hemp-derived"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link URL"
    }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}